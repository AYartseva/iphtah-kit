#!/usr/bin/env python3
"""verify-lot <worktree> [--client C] [--lot ID --agent AGENT_ID]
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import _purpose as P
STRAYS = re.compile(r"^(docs/PLAN_|memory/)")
UI_FILE = re.compile(r"\.(tsx|jsx|css|scss|html|vue|svelte)$")
MIGRATION = re.compile(r"(db/[\w-]*migrations?/(?:[^/]+/)?V\d+__[^/]+\.sql|migrations/\d{4}_[^/]+\.sql)$")
KEEP_CONTAINERS = ("play-",)
NODE_TESTS = ("vitest", "jest", "playwright")


def can_own_containers(cmd):
    ""
    argv = cmd.split()
    prog = argv[0].rsplit("/", 1)[-1] if argv else ""
    if prog == "java":
        return True
    script = argv[1] if len(argv) > 1 else ""
    return prog == "node" and any(t in script for t in NODE_TESTS)


def build_processes():
    ""
    out = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline") as f:
                cmd = f.read().replace("\0", " ").strip()
            if can_own_containers(cmd):
                out.append((os.path.realpath(f"/proc/{pid}/cwd"), cmd))
        except OSError:
            pass
    return out


def lot_containers(wt, names, procs):
    ""
    kept = [n for n in names if n and n.startswith(KEEP_CONTAINERS)]
    names = [n for n in names if n and not n.startswith(KEEP_CONTAINERS)]
    wt = os.path.realpath(wt)
    mine = any(c == wt or c.startswith(wt + os.sep) for c, _ in procs)
    if mine or not procs:
        return names, [], kept
    return [], names, kept


def sh(args, cwd=None):
    r = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip()


def client_for(path, client):
    clients = [client] if client else [os.path.basename(d) for d in
                                       sorted(os.listdir(os.path.expanduser("~/.claude/iphtah-kit/clients")))]
    remote = sh(["git", "remote", "get-url", "origin"], cwd=path)
    for c in clients:
        pj = os.path.expanduser(f"~/.claude/iphtah-kit/clients/{c}/project.json")
        if not os.path.exists(pj):
            continue
        cfg = json.load(open(pj))
        for name, r in cfg.get("repos", {}).items():
            if r.get("github") and r["github"] in remote:
                return c, cfg, name, r
    sys.exit(f"no client's project.json names the repository of {path} ({remote})")


PHONE_CHECK = "phone-check"
PHONE_ABSENT = (" (phone-check is the kit developers' screenshot tool, not in this kit: shoot with a tool that "
                "writes phone-check.json, or pass --no-ui-proof \"<why>\")")
MANIFEST = "phone-check.json"


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def shots_proof(proof_dir, head, wt):
    ""
    rerun = f"rerun {PHONE_CHECK} --out {proof_dir} on the final commit and look at the screenshots{PHONE_ABSENT}"
    if not head:
        return False, "UNPROVEN: no HEAD commit to compare the screenshots with"
    if not os.path.isdir(proof_dir):
        return False, f"NONE: {proof_dir} is not a directory"
    try:
        with open(os.path.join(proof_dir, MANIFEST)) as f:
            runs = json.load(f).get("runs")
    except FileNotFoundError:
        return False, f"UNPROVEN: no {MANIFEST} in {proof_dir} (shots by hand or an older phone-check): {rerun}"
    except (OSError, ValueError, AttributeError):
        return False, f"UNPROVEN: {MANIFEST} in {proof_dir} is unreadable: {rerun}"
    if not isinstance(runs, list) or not runs:
        return False, f"UNPROVEN: {MANIFEST} in {proof_dir} lists no run: {rerun}"
    count = 0
    for r in runs:
        sha, shots = (r.get("sha"), r.get("shots")) if isinstance(r, dict) else (None, None)
        what = r.get("target", "?") if isinstance(r, dict) else "?"
        if not isinstance(shots, dict) or not shots:
            return False, f"UNPROVEN: a run of {what} lists no screenshot: {rerun}"
        repo = r.get("repo")
        if sha and (not isinstance(repo, str) or os.path.realpath(repo) != os.path.realpath(wt)):
            if sha == head:
                return False, (f"ELSEWHERE: {what} was shot from {repo}, not from this worktree {wt}: rerun "
                               f"{PHONE_CHECK} --repo {wt} --out {proof_dir}{PHONE_ABSENT}")
            return False, (f"ELSEWHERE: {MANIFEST} holds a run of {what} from another checkout ({repo}, at "
                           f"{str(sha)[:8]}), another lot's in a shared --out? Shoot this lot into a fresh --out, "
                           f"with --repo {wt} for a URL")
        if sha != head:
            return False, (f"STALE: {what} was shot on {str(sha)[:8] if sha else 'no commit'}, "
                           f"HEAD is {head[:8]}: {rerun}")
        if r.get("dirty") is not False:
            how = ("with uncommitted changes" if r.get("dirty")
                   else "on a tree of unknown state (outside a repository, or the commit moved during the run)")
            return False, f"STALE: {what} was shot on {head[:8]} {how}: {rerun}"
        for name, digest in shots.items():
            path = os.path.join(proof_dir, os.path.basename(name))
            if not os.path.isfile(path):
                return False, f"UNPROVEN: {name} is listed but missing: {rerun}"
            try:
                same = _sha256(path) == digest
            except OSError as e:
                return False, f"UNPROVEN: {name} could not be read ({e.strerror}): {rerun}"
            if not same:
                return False, f"UNPROVEN: {name} is not the picture phone-check took: {rerun}"
            count += 1
        if r.get("ok") is not True:
            widths = r.get("widths")
            widths = ",".join(str(w) for w in widths) if isinstance(widths, list) and widths else "?"
            return False, (f"FAILED: phone-check failed on {what} (widths {widths}): fix the page, then rerun "
                           f"{PHONE_CHECK} --out {proof_dir} and look at the screenshots{PHONE_ABSENT}")
    return True, f"fresh ({count} screenshot(s) shot by phone-check on HEAD {head[:8]}, clean tree, passed)"


def ui_proof(wt, ui_files, proof_dir=None, waived=None, head=None):
    ""
    if not ui_files:
        return True, "n/a (no screen file changed)"
    if waived:
        return True, f"waived: {waived}"
    if proof_dir:
        return shots_proof(proof_dir, head or "", wt)
    edits = [os.path.getmtime(os.path.join(wt, f)) for f in ui_files if os.path.exists(os.path.join(wt, f))]
    last_edit = max(edits) if edits else 0
    runs = []
    pw = os.path.join(wt, "test-results", ".last-run.json")
    if os.path.exists(pw):
        try:
            status = json.load(open(pw)).get("status")
        except (OSError, ValueError):
            status = "unreadable"
        runs.append(("browser run", os.path.getmtime(pw), status))
    if not runs:
        return False, (f"NONE for {len(ui_files)} changed screen file(s): run {PHONE_CHECK} / the responsive "
                       f"spec, or --no-ui-proof \"<why>\"{PHONE_ABSENT}")
    fresh = [r for r in runs if r[1] >= last_edit and r[2] == "passed"]
    if fresh:
        return True, f"fresh ({fresh[0][0]}, passed, after the last screen edit)"
    worst = runs[0]
    why = "older than the last screen edit" if worst[1] < last_edit else f"status {worst[2]}"
    return False, f"STALE: {worst[0]} {why} — rerun it on the final code and look at the screenshots"


DOD_FILE = "dod.md"
DOD_LINES = 12
DOD_NO_CODE = (3, 7, 8, 9, 11)
DOD_FORM = "each item on its own line: « N. a test, or what runs », or « N. n/a: why »"
DOD_ITEM = re.compile(r"^\s*(?:[-*#]+\s*)?\**(\d{1,3})\**\s*[.):]\s*(.*)$")
DOD_NA = re.compile(r"^\s*(?:n\s*[./]?\s*a\.?|not applicable|non applicable|sans objet)\b[\s:.,;()—–-]*(.*)$", re.I | re.S)
WORD = re.compile(r"[^\W\d_]{2,}")
DUPLICATE = re.compile(r"(?i)(?:_v\d+|_new|_old|[ _-]copy(?: ?\d+)?)(?=(?:\.[^./]*)*$)")


def dod_answers(text):
    ""
    out, current = {}, None
    for line in text.splitlines():
        m = DOD_ITEM.match(line)
        if m:
            current = int(m.group(1))
            out[current] = [m.group(2)]
        elif current is not None and line.strip():
            out[current].append(line.strip())
    return {n: " ".join(parts).strip() for n, parts in out.items()}


def dod_check(text, required):
    ""
    answers = dod_answers(text)
    bad = []
    for n in required:
        a = answers.get(n, "")
        na = DOD_NA.match(a)
        if na is not None:
            if not WORD.search(na.group(1)):
                bad.append(f"line {n}: n/a without a reason")
        elif not WORD.search(a):
            bad.append(f"line {n}: missing")
    return not bad, ("answered" if not bad else "; ".join(bad))


def dod_required(no_code, catches):
    ""
    return list(DOD_NO_CODE) if no_code else list(range(1, DOD_LINES + 1 + len(catches or ())))


DOD_LABEL = re.compile(r"^[\s*«\"'(]*([^:]{2,60}?)[\s*»\"')]*:")
DOD_LABEL_WORDS = 8
DOD_STRONG = 2
STEM = re.compile(r"[^\W\d_]{4,}")
STEM_SKIP = frozenset("with without every that this their them from into only than more also must when where which "
                      "what whose each other once".split())
DOD_RENUMBER = ("a catch keeps its number (13 + its place in review_catches, new ones last, as the lot brief lists "
                "them): move the answer to its catch's number, or label it with that catch's words")


def stems(text):
    ""
    return {w[:5] for w in (x.lower() for x in STEM.findall(text)) if w not in STEM_SKIP}


def dod_label(answer):
    ""
    m = DOD_LABEL.match(answer)
    if not m or DOD_NA.match(m.group(1)) or len(m.group(1).split()) > DOD_LABEL_WORDS:
        return None
    return m.group(1).strip()


def dod_pairing(answers, catches):
    ""
    texts = [c if isinstance(c, str) else json.dumps(c, ensure_ascii=False) for c in (catches or ())]
    words = [stems(t) for t in texts]
    seen = {}
    for w in words:
        for x in w:
            seen[x] = seen.get(x, 0) + 1
    own_only = [{x for x in w if seen[x] == 1} for w in words]
    bad, paired = [], 0
    for i, own in enumerate(words):
        n = DOD_LINES + 1 + i
        label = dod_label(answers.get(n, ""))
        if label is None:
            continue
        said = stems(label)
        if said & own:
            paired += 1
            continue
        strong = [j for j, w in enumerate(own_only) if j != i and len(said & w) >= DOD_STRONG]
        if strong:
            j = max(strong, key=lambda k: len(said & own_only[k]))
            bad.append(f"line {n} « {label} » reads like catch {DOD_LINES + 1 + j} (« {texts[j][:40]}… »), "
                       f"not catch {n} (« {texts[i][:40]}… »)")
    return bad, paired


def no_code(row, changed):
    ""
    kind = (row or {}).get("type") if isinstance(row, dict) else None
    if isinstance(kind, dict) and kind.get("kind") == "research":
        return True, "ledger type research"
    if not changed:
        return True, "no file changed against the base"
    return False, None


def launched_before_check(row):
    ""
    return isinstance(row, dict) and row.get("dod") is not True


def dod_roots():
    ""
    roots = [P.stable_root()]
    own = os.environ.get("CLAUDE_SCRATCHPAD")
    if own and os.path.realpath(own) != os.path.realpath(roots[0]):
        roots.append(own)
    return roots


def dod_line(lot, row, changed, catches, roots=None, why_no_row="no ledger row for the lot"):
    ""
    if not lot:
        return True, f"not checked (no --lot: the answers live in <scratch>/<lot>/{DOD_FILE})"
    if launched_before_check(row):
        return True, "not checked (launched before the check)"
    if not P.valid_lot(lot):
        return False, f"MISSING: « {lot} » is not a plain lot name, so its {DOD_FILE} has no folder"
    nc, why = no_code(row, changed)
    required = dod_required(nc, catches)
    scope = f"{len(required)} line(s)" + (f", no code: {why}" if nc else "")
    paths = [os.path.join(r, lot, DOD_FILE) for r in (roots or dod_roots())]
    for p in paths:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                text = f.read()
        except FileNotFoundError:
            continue
        except OSError as e:
            return False, f"UNREADABLE: {p} ({e.strerror})"
        ok, what = dod_check(text, required)
        mismatched, by_label = dod_pairing(dod_answers(text), () if nc else catches)
        span = (f"catch {DOD_LINES + 1}" if len(catches or ()) == 1
                else f"catches {DOD_LINES + 1}-{DOD_LINES + len(catches or ())}")
        paired = (f"; {span}: {by_label} paired by label, {len(catches) - by_label} by number only"
                  if catches and not nc else "")
        if ok and not mismatched:
            return True, f"answered (presence only, {scope}{paired}) in {p}"
        what = "; ".join(([] if ok else [what]) + mismatched)
        hints = "; ".join(([] if ok else [DOD_FORM]) + ([DOD_RENUMBER] if mismatched else []))
        return False, f"{'NOT ANSWERED' if not ok else 'MISNUMBERED'}: {what} ({scope}) in {p}; {hints}"
    row_note = "" if row is not None else f"; {why_no_row}, so it counts as launched after the check"
    return False, f"MISSING: no {DOD_FILE} at {' or '.join(paths)} ({scope}{row_note}); {DOD_FORM}"


MUTANT_RECORD = "mutant-check.last.json"
MUTANT_OK = ("ran", "nothing to prove")
MUTANT_NO_VERDICT = ("not run", "running")
WAIVED = re.compile(r"^\s+mutant-check: waived: (.+)$", re.M)
MUTANT_HOW = "rerun mutant-check when there is room, or ask the session for a waiver (rule 11)"


def mutant_waived(report):
    ""
    m = WAIVED.search(report or "")
    return f"mutant-check waived: {m.group(1).strip()}" if m else None


def mutant_waiver(row):
    ""
    waivers = row.get("waivers") if isinstance(row, dict) else None
    whys = [w.get("why") for w in waivers if isinstance(w, dict) and w.get("kind") == "mutant"] \
        if isinstance(waivers, list) else []
    whys = [" ".join(w.split()) for w in whys if isinstance(w, str) and WORD.search(w)]
    return whys[-1][:300] if whys else None


def _alive(pid):
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def mutant_line(wt, head, waiver=None, lot=None):
    ""
    gdir = sh(["git", "rev-parse", "--absolute-git-dir"], cwd=wt)
    if not os.path.isabs(gdir):
        return False, f"UNREADABLE: {wt} has no git dir to read mutant-check's record from"
    path = os.path.join(gdir, MUTANT_RECORD)
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            rec = json.loads(f.read(1 << 20))
    except FileNotFoundError:
        return True, "not checked (no mutant-check run in this worktree)"
    except (OSError, ValueError):
        rec = None
    status, at = (rec.get("status"), rec.get("head")) if isinstance(rec, dict) else (None, None)
    if not isinstance(at, str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", at) or status not in MUTANT_OK + MUTANT_NO_VERDICT:
        return (True, f"waived: {waiver} (because the record is unreadable: {path})") if waiver else \
            (False, f"UNREADABLE: {path}: {MUTANT_HOW}")
    later = 0
    if at == head:
        where = f"on HEAD {at[:8]}"
    elif subprocess.run(["git", "merge-base", "--is-ancestor", at, head], cwd=wt, capture_output=True).returncode == 0:
        later = sh(["git", "rev-list", "--count", f"{at}..{head}"], cwd=wt)
        where = f"on {at[:8]}, an earlier commit of this branch"
    elif rec.get("branch") == sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=wt) and status in MUTANT_NO_VERDICT:
        where = f"on {at[:8]}, this branch before its history was rewritten"
    else:
        return True, f"not checked (the last run, on {at[:8]}, is not in this branch's history)"

    def said(key):
        items = rec.get(key)
        items = [str(i) for i in items] if isinstance(items, list) else []
        text = "; ".join(i.strip() for i in items if i.strip())
        return text[:400] + (" …" if len(text) > 400 else "")
    if status in MUTANT_OK:
        what = (f"ran {where}: {said('summary') or '(no summary line recorded)'}" if status == "ran"
                else f"nothing to prove {where}" + (f" ({said('nothing')})" if said("nothing") else ""))
        return True, what + (f"; {later} later commit(s) not checked" if later else "")
    if status == "not run":
        why = f"NOT RUN {where}: {said('reasons') or 'no reason recorded'}"
    elif _alive(rec.get("pid")):
        why = f"NO VERDICT {where}: a run is in progress (pid {rec['pid']})"
    else:
        why = f"NO VERDICT {where}: the run was killed before its verdict"
    if waiver:
        return True, f"waived: {waiver} (because {why})"
    return False, f"{why}. {MUTANT_HOW[0].upper() + MUTANT_HOW[1:]}" + (
        "; after a rewrite, rerun mutant-check on HEAD" if "rewritten" in where else "")


def duplicates(added, existing):
    ""
    existing = set(existing)
    out = []
    for f in added:
        d, name = os.path.split(f)
        sibling = DUPLICATE.sub("", name, count=1)
        if sibling != name and os.path.join(d, sibling) in existing:
            out.append(f)
    return out


def _lots():
    loader = importlib.machinery.SourceFileLoader("lots_for_verify", os.path.join(HERE, "lots"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def ledger_row(client, lot):
    ""
    try:
        d = _lots().load(client)
        row = (d.get("lots") or {}).get(lot) if isinstance(d, dict) else None
    except Exception as e:
        return None, "ledger unreadable: " + (str(e).strip().splitlines() or ["?"])[-1][:200]
    return (row, None) if isinstance(row, dict) else (None, "no ledger row for the lot")


def builder_line(c, lot, row, lots_mod=None):
    ""
    if not lot:
        return "not checked (no --lot)"
    if not isinstance(row, dict):
        return "not checked (no ledger row for the lot)"
    try:
        L = lots_mod or _lots()
        act = row.get("actuals")
        if isinstance(act, dict) and act:
            b = int(act.get("build_agents") or 0)
            r, how = int(act.get("agents") or 0) - b, "frozen"
        else:
            d, proj = L.client_ledger(c)
            (b, r), how = L.lot_agent_counts(d, proj, lot), "counted now"
        gap = L.builder_gap(lot, row, b, r)
    except Exception as e:
        return "not checked: " + ((str(e).strip().splitlines() or [type(e).__name__])[-1][:200] or type(e).__name__)
    return gap or f"{b} builder(s), {r} reviewer(s) counted ({how})"


def mechanical_checks(wt, base, c):
    ""
    out = []
    for tool, label in (("migration-lint", "sql lint:"), ("magic-number-lint", "magic numbers:"),
                        ("save-check", "save check:"), ("two-sources-lint", "two sources:")):
        try:
            r = subprocess.run([os.path.join(HERE, tool), wt, "--base", f"origin/{base}"]
                               + (["--client", c] if tool == "two-sources-lint" else []),
                               capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            out.append((label, None))
            continue
        lines = [l for l in r.stdout.splitlines() if l.startswith(("ERROR", "warn", "allowed", "not checked"))]
        if r.returncode >= 2:
            lines.append(f"{tool} NOT CHECKED: {(r.stderr.strip().splitlines() or ['?'])[-1]}")
        out.append((label, lines))
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("worktree")
    ap.add_argument("--client")
    ap.add_argument("--lot")
    ap.add_argument("--agent")
    ap.add_argument("--proof", help="a directory of screenshots taken for this change")
    ap.add_argument("--no-ui-proof", metavar="WHY")
    a = ap.parse_args()
    wt = os.path.expanduser(a.worktree)
    c, cfg, repo_name, repo = client_for(wt, a.client)
    base = repo.get("base", "main")
    sh(["git", "fetch", "-q", "origin", base], cwd=wt)
    head = sh(["git", "rev-parse", "HEAD"], cwd=wt)
    subject = sh(["git", "log", "-1", "--format=%s"], cwd=wt)
    branch = sh(["git", "branch", "--show-current"], cwd=wt) or "(detached)"
    status = sh(["git", "status", "--porcelain"], cwd=wt).splitlines()
    tracked = [l for l in status if not l.startswith("??")]
    untracked = [l[3:] for l in status if l.startswith("??")]
    green_file = os.path.join(os.path.expanduser(cfg["state_dir"]), "green-builds")
    greens = [l for l in open(green_file).read().splitlines() if head in l] if os.path.exists(green_file) else []
    changed = sh(["git", "diff", "--name-only", f"origin/{base}...HEAD"], cwd=wt).splitlines()
    strays = [f for f in changed if STRAYS.match(f)]
    migrations = [f for f in changed if MIGRATION.search(f)]
    containers, other_containers, kept_containers = lot_containers(
        wt, sh(["docker", "ps", "--format", "{{.Names}}"]).splitlines(), build_processes())
    ui_ok, ui_line = ui_proof(wt, [f for f in changed if UI_FILE.search(f) and "/test" not in f
                                   and ".test." not in f and ".spec." not in f], a.proof, a.no_ui_proof, head)
    copies = duplicates(sh(["git", "diff", "--name-only", "--diff-filter=AR", f"origin/{base}...HEAD"], cwd=wt).splitlines(),
                        sh(["git", "ls-tree", "-r", "--name-only", "HEAD"], cwd=wt).splitlines()
                        + sh(["git", "ls-tree", "-r", "--name-only", f"origin/{base}"], cwd=wt).splitlines())
    row, why_no_row = ledger_row(c, a.lot) if a.lot else (None, None)
    dod_ok, dod_text = dod_line(a.lot, row, changed, cfg.get("review_catches"), why_no_row=why_no_row or "")
    mutant_ok, mutant_text = mutant_line(wt, head, mutant_waiver(row), a.lot)
    ok = not tracked and greens and not strays and not containers and ui_ok and not copies and dod_ok and mutant_ok
    print(f"{c} / {repo_name} — {branch} @ {head[:8]}  {subject}")
    print(f"  tree:        {'clean' if not tracked else f'{len(tracked)} uncommitted change(s)'}"
          f"{f' ({len(untracked)} untracked)' if untracked else ''}")
    print(f"  green:       {greens[-1] if greens else 'NO green record for this commit'}")
    print(f"  strays:      {', '.join(strays) if strays else 'none'}")
    print(f"  migrations:  {', '.join(os.path.basename(m) for m in migrations) if migrations else 'none'}")
    print(f"  containers:  {', '.join(containers) if containers else 'none left'}"
          f"{f' (other builds containers, ignored: {len(other_containers)})' if other_containers else ''}"
          f"{' (kept: ' + ', '.join(kept_containers) + ')' if kept_containers else ''}")
    print(f"  phone proof: {ui_line}")
    print(f"  copies:      {', '.join(copies) if copies else 'none'}"
          f"{' (a file named _v2 / _new / _old / copy beside its original: a duplicate)' if copies else ''}")
    print(f"  definition of done: {dod_text}")
    print(f"  mutant-check: {mutant_text}")
    print(f"  builder:     {builder_line(c, a.lot, row)}")
    print("  zero waste /tmp: not checked (shared /tmp)")
    print("  scope of the diff: not checked (the diff is not compared with the scout's goesWhere)")
    for label, lines in mechanical_checks(wt, base, c):
        print(f"  {label:<13}{'timed out (120 s)' if lines is None else 'none' if not lines else f'{len(lines)} finding(s)'}")
        for l in lines or []:
            print(f"    {l}")
    if a.lot and a.agent:
        subprocess.run([os.path.join(HERE, "lots"), "--client", c, "agents", a.lot, a.agent], check=False)
        print(f"  lot:         agent {a.agent} attached to {a.lot}")
    print("  verdict:     " + ("OK" if ok else "NOT READY"))
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
